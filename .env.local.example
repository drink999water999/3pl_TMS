# ----------------------------------------------------------------------------
# FastLane TMS — environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and never committed.
# ----------------------------------------------------------------------------

# --- Supabase (LOCAL stack) ---------------------------------------------------
# Run `supabase start` (or `supabase status`) and map the printed keys EXACTLY
# as below. Newer CLIs label them "Publishable" / "Secret"; older ones label
# them "anon key" / "service_role key" — they mean the same thing:
#
#   API URL .................. NEXT_PUBLIC_SUPABASE_URL   (usually the one below)
#   Publishable / anon key ... NEXT_PUBLIC_SUPABASE_ANON_KEY   (public, browser-safe)
#   Secret / service_role .... SUPABASE_SERVICE_ROLE_KEY       (SERVER ONLY — never NEXT_PUBLIC)
#
# ⚠️  Do NOT swap these. The Secret/service_role key must NOT go in a
#     NEXT_PUBLIC_ variable, or it would be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="FastLane Logistics"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- First admin (used by `pnpm seed:admin`; optional overrides) ---------------
# If omitted, defaults to admin@fastlane.local / ChangeMe123!.
ADMIN_EMAIL=admin@fastlane.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME="FastLane Admin"

# --- Email (waybill "Email" button) -------------------------------------------
# Pick ONE option. If none are set, approve/download/print still work; only the
# Email button is disabled with a setup hint. Priority: Gmail/SMTP first, then
# Resend.
#
# OPTION A — Gmail (easiest, recommended). Uses an App Password, NOT your normal
# password. Turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords and paste the 16-char code below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: the "from" shown to recipients (defaults to GMAIL_USER).
# SMTP_FROM="FastLane Logistics <you@gmail.com>"
#
# OPTION B — any other SMTP server (Outlook/Office365, company mail, etc.).
# Leave the Gmail fields blank and fill these instead.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465, false for 587/STARTTLS
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=
# SMTP_FROM="FastLane Logistics <you@yourcompany.com>"
#
# OPTION C — Resend (hosted). Create a key at https://resend.com/api-keys.
# For real sending verify your own domain and use an address on it.
RESEND_API_KEY=
RESEND_FROM_EMAIL="FastLane Logistics <onboarding@resend.dev>"
